# npm run setup creates local-only .dev.vars; never commit real values.
APP_ORIGIN=http://127.0.0.1:8788
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
ADMIN_PASSWORD_HASH=<PBKDF2 hash generated by scripts/setup.mjs>
ENCRYPTION_KEY=<base64 32 random bytes>
SESSION_SECRET=<base64 32 random bytes>
# Exact public HTTPS DNS names. No IPs, private DNS, redirects or wildcards.
CUSTOM_PROVIDER_HOSTS=api.openai.com,api.anthropic.com
# Default Claude is disabled: upstream marks it deprecated/RISK_NOTICE.
# Enable only after verifying subscription OAuth inference is permitted for your account.
CLAUDE_SCHEDULER_ENABLED=false
# Leave blank for provider's supported loopback flow + paste callback URL.
# Override only with a redirect URI registered for the OAuth client ID.
CODEX_REDIRECT_URI=http://localhost:1455/auth/callback
# Claude uses APP_ORIGIN/api/oauth/claude/callback by default, matching local 9Router.
CLAUDE_REDIRECT_URI=
# Optional registered public OAuth clients; defaults extracted from local 9Router.
CODEX_CLIENT_ID=
CLAUDE_CLIENT_ID=
# Local only: Node bridge used when upstream blocks Cloudflare workerd egress.
UPSTREAM_PROXY_URL=http://127.0.0.1:8789/fetch
