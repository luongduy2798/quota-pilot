{
  "name": "quota-pilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run build && node --import tsx server/node.ts",
    "start": "node --import tsx server/node.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/*.integration.ts",
    "lint": "eslint server web test scripts",
    "format": "prettier --write server web test scripts *.json *.ts *.html docs/*.md README.md",
    "format:check": "prettier --check server web test scripts *.json *.ts *.html docs/*.md README.md"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12"
  }
}
