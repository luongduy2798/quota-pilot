{
  "manifest_version": 3,
  "name": "Quota Pilot OAuth Callback",
  "version": "1.0.0",
  "description": "Routes the Codex localhost OAuth callback back to Quota Pilot.",
  "permissions": ["storage", "tabs", "webNavigation"],
  "host_permissions": [
    "https://quota.chillix.me/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://quota.chillix.me/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
