{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quota-pilot",
  "main": "server/index.ts",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "assets": { "directory": "dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/healthz"] },
  "d1_databases": [{ "binding": "DB", "database_name": "quota-pilot", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "APP_ORIGIN": "http://127.0.0.1:8788", "DEFAULT_TIMEZONE": "Asia/Ho_Chi_Minh", "CUSTOM_PROVIDER_HOSTS": "api.openai.com,api.anthropic.com", "CLAUDE_SCHEDULER_ENABLED": "false" },
  "dev": { "port": 8788, "ip": "127.0.0.1" },
  "observability": { "enabled": false }
}
